{
  "manifest_version": 3,
  "name": "OriginKeep Companion",
  "version": "0.1.0",
  "description": "Captures browser download provenance for the local OriginKeep desktop app.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "OriginKeep Companion",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
